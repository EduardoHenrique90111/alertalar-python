# =====================================================================
#  AlertaLar - variáveis de ambiente (exemplo)
#  1. Copie este arquivo para ".env" na raiz do projeto
#  2. Preencha os valores. O .env NÃO deve ir para o Git (já está no .gitignore).
#  Formato: CHAVE=valor (sem aspas). Variáveis de ambiente do sistema têm prioridade.
# =====================================================================

# ---------- Banco de dados PostgreSQL ----------
DB_URL=postgresql://localhost:5432/alertalar
DB_USERNAME=alertalar
DB_PASSWORD=troque_esta_senha
# Alternativa às três linhas acima: a connection string do Neon numa variável só
# DATABASE_URL=postgresql://USUARIO:SENHA@ep-....neon.tech/neondb?sslmode=require
# Conexões abertas ao mesmo tempo (no plano gratuito do Neon, use 5)
# DB_POOL=10

# ---------- Servidor ----------
PORT=8080
# Em produção com HTTPS, use true (cookie de sessão só trafega em conexão segura)
COOKIE_SECURE=false
# Atrás de proxy reverso (Nginx, Render, Railway...), use: framework
FORWARD_HEADERS_STRATEGY=none
# Origens extras liberadas no CORS, separadas por vírgula (vazio = somente a própria origem)
ALERTALAR_CORS_ORIGENS=

# ---------- Administrador inicial (moderação e importação de dados oficiais) ----------
# Criado na primeira inicialização se as duas variáveis estiverem preenchidas.
# Senha: mínimo de 10 caracteres, com letras e números.
ALERTALAR_ADMIN_NOME=Administrador
ALERTALAR_ADMIN_EMAIL=
ALERTALAR_ADMIN_SENHA=

# ---------- Identificação perante as APIs públicas ----------
# A política do Nominatim (OpenStreetMap) pede um contato no User-Agent.
ALERTALAR_CONTATO_EMAIL=
# Endereço público do site, também enviado no User-Agent (no Render é preenchido sozinho).
# ALERTALAR_URL_PUBLICA=https://alertalar-python.onrender.com

# ---------- Endereços das APIs externas (opcional: os padrões já apontam para os serviços públicos) ----------
# VIACEP_URL=https://viacep.com.br/ws
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# Reserva da busca de endereços (quando o Nominatim recusa pedidos ou não responde)
# PHOTON_URL=https://photon.komoot.io
# IBGE_URL=https://servicodados.ibge.gov.br/api/v1/localidades
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# OPEN_METEO_ELEVACAO_URL=https://api.open-meteo.com/v1/elevation
# OPEN_METEO_PREVISAO_URL=https://api.open-meteo.com/v1/forecast
# OPEN_METEO_VAZAO_URL=https://flood-api.open-meteo.com/v1/flood
# SGB_SETORES_RISCO_URL=https://geoportal.sgb.gov.br/server/rest/services/gestaoterritorial/risco/MapServer/0
# Tempo limite das chamadas às APIs externas (ex.: 5s, 25s)
# ALERTALAR_TIMEOUT_CONEXAO=5s
# ALERTALAR_TIMEOUT_LEITURA=25s

# ---------- Rota segura (opcional) ----------
# Servidor de rotas compatível com o Valhalla. O padrão é o servidor público da FOSSGIS
# (gratuito, sem chave, máximo de 1 requisição por segundo). Para uso intenso, use uma
# instância própria ou um provedor compatível e informe a chave, se houver.
# ROTAS_URL=https://valhalla1.openstreetmap.de
# ROTAS_CHAVE_API=

# ---------- Outras opções ----------
# Interface de rede do servidor (padrão: todas)
# ALERTALAR_HOST=0.0.0.0
# Nível dos registros (log): DEBUG, INFO, WARNING
# ALERTALAR_LOG=INFO
# Pasta do site, se não estiver em ./frontend
# ALERTALAR_FRONTEND=
# Aplicar as migrações do banco ao iniciar (padrão: true)
# ALERTALAR_APLICAR_MIGRACOES=true

# ---------- Teste de integração completo (opcional) ----------
# Use um banco EXCLUSIVO para testes: o teste apaga os dados dele.
# Estas três precisam ser variáveis de ambiente de verdade (o .env não é lido pelos testes).
# ALERTALAR_TEST_DB_URL=postgresql://localhost:5432/alertalar_test
# ALERTALAR_TEST_DB_USERNAME=alertalar
# ALERTALAR_TEST_DB_PASSWORD=troque_esta_senha
